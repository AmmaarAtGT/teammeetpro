# ========================================================
# TeamMeet Pro — Production Environment Variables
# ========================================================

# App Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Server Domain & IP (Set your server domain or public IP)
JITSI_DOMAIN=meet.yourcompany.com
PUBLIC_IP=YOUR_SERVER_PUBLIC_IP

# Role Access Control (1-2 Authorized Users for Rec & Notes toggles)
MODERATOR_PIN=889922
AUTHORIZED_MODERATOR_EMAILS=admin@infotechlaunch.com,host@infotechlaunch.com
JWT_SECRET=teammeet_pro_ultra_secure_jwt_secret_2026

# Google Drive & Sheets Integration (For auto-upload to provided links)
# Paste your Google Cloud Service Account details here:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_API_KEY=

# AI Note-Keeping Engine (Gemini API for speaker summaries & action items)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Jitsi Internal Passwords (Auto-generated or custom)
JICOFO_AUTH_PASSWORD=jicofo_pass_random_secure_123
JVB_AUTH_PASSWORD=jvb_pass_random_secure_456
